# .env.example
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Doctor Portal (Supabase) ────────────────────────────────────────────────
# Client-side (safe to expose in the browser bundle — must be VITE_ prefixed).
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side ONLY (Vercel serverless functions). NEVER prefix these with VITE_
# and never expose them in the browser. The service role key can bypass all
# security rules, so treat it like a password.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Doctor Portal emails (server-side ONLY — never VITE_) ────────────────────
# The academy mailbox that sends notifications (Gmail: use an App Password,
# created in the Google account under Security -> 2-Step Verification).
# Leave empty and the portal still works — it just sends no emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=medident-ks@gmail.com
SMTP_PASS=
SMTP_FROM="Medident Academy <medident-ks@gmail.com>"
# Optional
PORTAL_URL=https://medident-ks.com/academy/portal
ACADEMY_CONTACT_EMAIL=medident-ks@gmail.com
# Extra addresses (comma separated) that get admin notifications.
ADMIN_NOTIFY_EMAIL=
# If set, Vercel Cron sends it automatically; protects the daily reminder job.
CRON_SECRET=
